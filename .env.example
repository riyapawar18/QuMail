# ---------------------------------------------------------------------------
# QuMail environment example — copy to .env and edit locally.
# NEVER commit .env, client_secret.json, token.json, private keys, or real
# user documents. See .gitignore.
# ---------------------------------------------------------------------------

# --- Application ---
# development | production (informational)
APP_ENV=development
LOG_LEVEL=INFO
# Port the API binds to. Render/Railway inject PORT automatically.
PORT=8000
# 1 = show Guest Demo entry point and allow demo APIs, 0 = disable
QMAIL_DEMO_MODE=1
# Guest session lifetime and capacity (in-memory)
DEMO_SESSION_TTL_SECONDS=7200
DEMO_MAX_SESSIONS=200
# Number of synthetic keys generated by the software KME in demo mode
KME_DEMO_KEY_COUNT=50

# --- Frontend / CORS ---
# Comma-separated browser origins allowed to call the API.
# In production the frontend is served by FastAPI (same origin), so CORS can
# stay limited to local development origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage (portable relative or absolute paths) ---
# Runtime mail store, token, key pool, and attachments. On ephemeral hosts
# this data is lost on redeploy/restart; use a persistent volume for real use.
QMAIL_DATA_DIR=./backend
# Directory containing the compiled React app (npm run build output).
FRONTEND_BUILD_DIR=./build

# --- Google OAuth / Gmail (optional; guest demo works without it) ---
# Create a **Web application** OAuth client in Google Cloud Console.
# Authorized redirect URI (local): http://127.0.0.1:8000/auth/google/callback
# Authorized redirect URI (deployed): https://YOUR-SERVICE.onrender.com/auth/google/callback
#
# Preferred for Render/Railway: paste the whole downloaded client JSON into a
# platform secret named GOOGLE_CLIENT_SECRET_JSON.
# GOOGLE_CLIENT_SECRET_JSON={"web":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}
GOOGLE_CLIENT_SECRET_FILE=./backend/client_secret.json
# Multi-account token store (created after OAuth consent). Keep it server-side.
GOOGLE_TOKEN_FILE=./backend/token.json
# Exact redirect URI registered with Google. Leave blank to derive it from
# PUBLIC_BASE_URL (or the request host) + /auth/google/callback.
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Public HTTPS origin of the backend (recommended behind Render's proxy).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional separate frontend origin for post-OAuth redirects.
# FRONTEND_URL=https://app.example.com
# OAuth CSRF state lifetime (seconds)
OAUTH_STATE_TTL_SECONDS=600
# Browser session lifetime for the HttpOnly Google session cookie (seconds).
# Sessions are stored in server memory and end on restart.
GOOGLE_SESSION_TTL_SECONDS=43200

# Gmail API limits (bytes unless noted)
GMAIL_MAX_ATTACHMENTS=10
GMAIL_MAX_BODY_BYTES=1048576
GMAIL_MAX_RECIPIENTS=10
GMAIL_MAX_ATTACHMENT_BYTES=10485760
GMAIL_SEND_IDEMPOTENCY_TTL_SECONDS=600

# --- Key Management Entity (KME) ---
# Software KME used for Level 2 (QAES). Start it with:
#   python -m uvicorn kme_server:app --host 0.0.0.0 --port 8443
KME_URL=http://127.0.0.1:8443

# --- Identity server ---
# Used for Diffie-Hellman public-key exchange (Level 4) and key sync.
IDENTITY_URL=https://qumail-identity-server.onrender.com

# --- Mock DigiLocker (in-process demo document vault) ---
DIGILOCKER_URL=http://127.0.0.1:8444

# --- Frontend build-time API base (optional) ---
# Leave unset for same-origin. For a separately hosted frontend set this to the
# public backend origin, e.g. https://qumail.onrender.com
# REACT_APP_API_BASE=

# Inbox polling interval in milliseconds while the tab is visible.
# Set to 0 to disable polling (manual refresh still works). Minimum enforced: 15000.
REACT_APP_GMAIL_POLL_MS=60000
